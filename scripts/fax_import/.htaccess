# Deny all web access to this directory.
#
# The previous content was `<Files *> deny from * </Files>`, which matches no
# client (the argument of a Deny is a host or environment, not a wildcard - see
# scripts/.htaccess for the full note). Measured at HEAD, on Apache and on
# nginx: GET /scripts/fax_import/djvudigital returned 10351 bytes, HTTP 200.
#
# The parent scripts/.htaccess and the server configuration
# (doc/freemed.apache.conf / docker/nginx.conf) now both cover this directory
# recursively; this file is kept because it shipped, and because it states the
# intent locally for a vhost that serves this tree with neither of them.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	order deny,allow
	deny from all
</IfModule>
