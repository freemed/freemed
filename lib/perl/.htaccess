# Deny all web access to this directory.
#
# The previous content was `<Files *> deny from * </Files>`, which matches no
# client at all: the argument of a Deny is a host or environment, not a
# wildcard. Measured at HEAD, on Apache and on nginx: GET
# /lib/perl/Config/IniFiles.pm returned 70159 bytes of Perl source, HTTP 200.
#
# This is the only per-directory rule inside lib/: the repository has no
# lib/.htaccess and lib/Makefile installs `*.php` plus the subdirectories, so
# none is created for the installed layout either. The rule that therefore
# carries the whole lib/ tree is the server configuration
# (doc/freemed.apache.conf / docker/nginx.conf).
#
# Both access-control syntaxes are present and module-guarded so the file loads
# on Apache 2.2 and 2.4 alike: `Require all denied` needs mod_authz_core (2.4),
# `Order deny,allow` needs mod_access_compat (2.2, and 2.4 with the
# compatibility module).
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	order deny,allow
	deny from all
</IfModule>
