# Deny all web access to data/schema/ - the SQL schema is installed from the
# shell (`mysql < data/schema/mysql/patient.sql`), never fetched over HTTP.
#
# This is the SECOND layer. The load-bearing rule is the server configuration
# (doc/freemed.apache.conf for Apache, docker/nginx.conf for nginx): nginx reads
# no .htaccess at all, and a vhost with `AllowOverride None` ignores this file.
#
# The file used to carry 2.2-only syntax (`order allow,deny` / `deny from all`),
# which is a configuration error during URI mapping on an Apache 2.4 vhost
# without mod_access_compat (500, not the 403 this rule means). Both syntaxes are
# now present and module-guarded; the directive set is unchanged - the directory
# was already denied by the 2.2 half.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	order deny,allow
	deny from all
</IfModule>
